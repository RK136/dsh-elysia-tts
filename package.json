{
  "name": "dsh-elysia-tts",
  "version": "0.1.0",
  "description": "把 GPT-SoVITS 语音合成接进 DeepSeek Harness：随 DSH 自动拉起并守护推理服务，注册 elysia_tts 工具。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "gpt-sovits",
    "voice"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  }
}
